NODE_ENV=development
PORT=8001

MONGO_URL=mongodb://localhost:27017/westchesterCourierDB

BCRYPT_SALT_ROUNDS=12
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=365d

# Optional — if left blank, emails are logged instead of sent (see MailService),
# and OTP codes are returned directly in API responses in non-production environments.
SMTP_HOST=
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_MAIL=
SMTP_PASSWORD=
