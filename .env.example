NODE_ENV=development
PORT=8001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:2050
CORS_ORIGIN=http://localhost:2050,http://10.10.20.52:2050

MONGO_URL=mongodb://localhost:27017/westchesterCourierDB

BCRYPT_SALT_ROUNDS=12
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=365d

# Optional — if left blank, emails are logged instead of sent (see MailService),
# and OTP codes are returned directly in API responses in non-production environments.
SMTP_HOST=
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_MAIL=
SMTP_PASSWORD=

# Firebase Push Notification (FCM HTTP v1) Configuration
# Option A: Path to firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: Raw JSON string or Base64 encoded JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Option C: Direct credentials
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

